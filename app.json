{
  "expo": {
    "name": "GUSTS",
    "slug": "gusts-kitesurf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-1080.png",
      "resizeMode": "contain",
